RunService.RenderStepped:Connect(function()
	if antiKatanaEnabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local shield1 = p.Character:FindFirstChild("KatanaBlock")
				local shield2 = p.Character:FindFirstChild("KatanaShield")
				local shield3 = p.Character:FindFirstChild("Deflect")
				

local function setButtonState(isOn, label, indicator)
	if isOn then
		label.TextColor3 = Color3.fromRGB(0, 255, 128)
		indicator.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
	else
		label.TextColor3 = Color3.fromRGB(200, 200, 220)
		indicator.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
	end
end

UserInputService.InputBegan:Connect(function(input, gp)
	if input.KeyCode == Enum.KeyCode.M then
		menuOpen = not menuOpen
		
		if menuOpen then
			mainFrame.Visible = true
			mainFrame.Size = UDim2.new(0, 260, 0, 410)
			mainFrame.BackgroundTransparency = 1
			TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 280, 0, 440),
				BackgroundTransparency = 0.1
			}):Play()
		else
			local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Size = UDim2.new(0, 260, 0, 410),
				BackgroundTransparency = 1
			})
			tween:Play()
			tween.Completed:Connect(function()
				if not menuOpen then mainFrame.Visible = false end
			end)
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if menuOpen then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end)

-- 1. ESP Sistemi
local espCache = {}
espBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	setButtonState(espEnabled, espLabel, espInd)
	if not espEnabled then
		for _, item in pairs(espCache) do
			if item then item:Destroy() end
		end
		espCache = {}
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local char = p.Character
				local hrp = char:FindFirstChild("HumanoidRootPart")
				
				if hrp and not char:FindFirstChild("DevHighlight") then
					local hl = Instance.new("Highlight")
					hl.Name = "DevHighlight"
					hl.Adornee = char
					hl.FillColor = Color3.fromRGB(255, 50, 50)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.4
					hl.Parent = char
					table.insert(espCache, hl)
				end
				
				if hrp and not char:FindFirstChild("DevBoxESP") then
					local box = Instance.new("BoxHandleAdornment")
					box.Name = "DevBoxESP"
					box.Size = Vector3.new(3, 6, 2)
					box.Adornee = hrp
					box.AlwaysOnTop = true
					box.ZIndex = 5
					box.Transparency = 0.5
					box.Color3 = Color3.fromRGB(255, 50, 50)
					box.Parent = char
					table.insert(espCache, box)
				end
			end
		end
	end
end)

-- 2. Aimbot Sistemi (Sağ Tık İle Hard-Lock Kafa)
aimbotBtn.MouseButton1Click:Connect(function()
	aimbotEnabled = not aimbotEnabled
	setButtonState(aimbotEnabled, aimbotLabel, aimbotInd)
end)

RunService.RenderStepped:Connect(function()
	if aimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local closestHead = nil
		local shortestDist = math.huge
		
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
				local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local head = p.Character.Head
					local screenPoint, onScreen = camera:WorldToViewportPoint(head.Position)
					local mousePos = UserInputService:GetMouseLocation()
					local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
					
					if dist < shortestDist then
						shortestDist = dist
						closestHead = head
					end
				end
			end
		end
		
		if closestHead then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, closestHead.Position)
		end
	end
end)


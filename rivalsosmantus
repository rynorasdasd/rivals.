-- 1. ESP Logic
local espCache = {}
RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local char = p.Character
				local hrp = char:FindFirstChild("HumanoidRootPart")
				
				if hrp and not char:FindFirstChild("KoraxHighlight") then
					local hl = Instance.new("Highlight")
					hl.Name = "KoraxHighlight"
					hl.Adornee = char
					hl.FillColor = Color3.fromRGB(0, 170, 255)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.3
					hl.Parent = char
					table.insert(espCache, hl)
				end
			end
		end
	else
		for _, item in pairs(espCache) do
			if item then item:Destroy() end
		end
		espCache = {}
	end
end)

-- 2. Aimbot Logic (Sağ Tık)
RunService.RenderStepped:Connect(function()
	if aimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local closestHead = nil
		local shortestDist = math.huge
		
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
				local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local head = p.Character.Head
					local screenPoint, onScreen = camera:WorldToViewportPoint(head.Position)
					local mousePos = UserInputService:GetMouseLocation()
					local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
					
					if dist < shortestDist then
						shortestDist = dist
						closestHead = head
					end
				end
			end
		end
		
		if closestHead then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, closestHead.Position)
		end
	end
end)

-- 3. Speed Logic
RunService.RenderStepped:Connect(function()
	if speedEnabled and player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 60
		end
	end
end)

-- 4. Noclip Logic
RunService.Stepped:Connect(function()
	if noclipEnabled and player.Character then
		for _, part in pairs(player.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
end)

-- 5. Anti-Katana Logic
RunService.RenderStepped:Connect(function()
	if antiKatanaEnabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local s1 = p.Character:FindFirstChild("KatanaBlock")
				local s2 = p.Character:FindFirstChild("KatanaShield")
				local s3 = p.Character:FindFirstChild("Deflect")
				if s1 then s1:Destroy() end
				if s2 then s2:Destroy() end
				if s3 then s3:Destroy() end
			end
		end
	end
end)

-- 6. Weapon Glow Logic
RunService.RenderStepped:Connect(function()
	if weaponGlowEnabled then
		for _, obj in pairs(camera:GetDescendants()) do
			if obj:IsA("MeshPart") or obj:IsA("Part") then
				local name = obj.Name:lower()
				if name ~= "head" and name ~= "humanoidrootpart" then
					obj.Material = Enum.Material.Neon
					obj.Color = Color3.fromRGB(0, 255, 255)
				end
			end
		end
	end
end)
